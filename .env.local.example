# Salin file ini menjadi .env.local lalu isi dengan kredensial project Supabase Anda.
# Supabase Dashboard → Project Settings → API (atau "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Boleh diisi "anon public key" (eyJ...) atau "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (atau anon key lama) NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL aplikasi (dipakai untuk link undangan & redirect email konfirmasi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
